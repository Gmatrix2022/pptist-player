          "content": "<p style=\"margin:0;line-height:1.15;font-family:sans-serif;font-size:52px;font-weight:900;color:#0F172A;\">PPTist Player <span style=\"color:#2563EB;\">Zero-Dependency</span> Standalone Engine</p>"
